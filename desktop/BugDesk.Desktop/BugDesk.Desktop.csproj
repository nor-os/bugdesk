<Project Sdk="Microsoft.NET.Sdk">

  <!-- BugDesk in a native window (DeskKit.Desktop, on Photino.NET), the server
       in-process; see docs/desktop.md. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BugDesk.Desktop</RootNamespace>
    <AssemblyName>BugDesk</AssemblyName>
    <ApplicationIcon>..\..\ui\assets\icons\bugdesk.ico</ApplicationIcon>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DeskKit.Desktop" Version="0.1.0" />
    <!-- The server, as an assembly: started in this process, not as a child. -->
    <ProjectReference Include="..\..\server\BugDesk.Server.csproj" />
  </ItemGroup>

</Project>
