<Project Sdk="Microsoft.NET.Sdk">

  <!-- BugDesk in a native window (Photino.NET), the server in-process; see
       docs/desktop.md. Plain net10.0: the taskbar fixes are P/Invoke, so the
       24 MB Windows SDK projection a -windows target pulls in is not needed. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>BugDesk.Desktop</RootNamespace>
    <AssemblyName>BugDesk</AssemblyName>
    <ApplicationIcon>..\..\ui\assets\icons\bugdesk.ico</ApplicationIcon>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Photino.NET" Version="4.0.16" />
    <!-- The server, as an assembly: started in this process, not as a child. -->
    <ProjectReference Include="..\..\server\BugDesk.Server.csproj" />
  </ItemGroup>

</Project>
